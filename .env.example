# Snowflake connection — never commit real values, this file only documents
# the variable names. Copy to .env and fill in locally; .env is gitignored.
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=your_warehouse
SNOWFLAKE_DATABASE=SKILLPULSE
SNOWFLAKE_SCHEMA=ANALYTICS
SNOWFLAKE_ROLE=your_role

# Databricks (only needed if scripting outside the notebook UI)
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your_personal_access_token

# Optional backend service
API_PORT=8000
